<xml xmlns="http://www.w3.org/1999/xhtml" is_dbot="true" collection="false">
  <variables>
    <variable type="" id="stake_var">Stake</variable>
    <variable type="" id="take_profit_var">Take Profit</variable>
    <variable type="" id="stop_loss_var">Stop Loss</variable>
    <variable type="" id="martingale_var">Martingale Factor</variable>
    <variable type="" id="rsi_val">RSI Value</variable>
    <variable type="" id="macd_val">MACD Value</variable>
    <variable type="" id="bb_val">BB Value</variable>
    <variable type="" id="signal_var">Trade Signal</variable>
  </variables>

  <!-- 1. TRADE DEFINITION -->
  <block type="trade_definition" id="trade_def_block" deletable="false" x="0" y="0">
    <statement name="TRADE_OPTIONS">
      <block type="trade_definition_market" id="market_block" deletable="false" movable="false">
        <field name="MARKET_LIST">synthetic_index</field>
        <field name="SUBMARKET_LIST">random_index</field>
        <field name="SYMBOL_LIST">1HZ100V</field>
        <next>
          <block type="trade_definition_tradetype" id="type_block" deletable="false" movable="false">
            <field name="TRADETYPECAT_LIST">callput</field>
            <field name="TRADETYPE_LIST">higherlower</field>
            <next>
              <block type="trade_definition_contracttype" id="contract_block" deletable="false" movable="false">
                <field name="TYPE_LIST">both</field>
                <next>
                  <block type="trade_definition_candleinterval" id="candle_block" deletable="false" movable="false">
                    <field name="CANDLEINTERVAL_LIST">60</field>
                    <next>
                      <block type="trade_definition_restartonerror" id="restart_block" deletable="false" movable="false">
                        <field name="RESTARTONERROR">TRUE</field>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </statement>

    <!-- Initialization -->
    <statement name="INITIALIZATION">
      <block type="variables_set" id="set_stake">
        <field name="VAR" id="stake_var">Stake</field>
        <value name="VALUE">
          <block type="math_number" id="stake_num"><field name="NUM">1</field></block>
        </value>
        <next>
          <block type="variables_set" id="set_tp">
            <field name="VAR" id="take_profit_var">Take Profit</field>
            <value name="VALUE">
              <block type="math_number" id="tp_num"><field name="NUM">50</field></block>
            </value>
            <next>
              <block type="variables_set" id="set_sl">
                <field name="VAR" id="stop_loss_var">Stop Loss</field>
                <value name="VALUE">
                  <block type="math_number" id="sl_num"><field name="NUM">30</field></block>
                </value>
                <next>
                  <block type="variables_set" id="set_mg">
                    <field name="VAR" id="martingale_var">Martingale Factor</field>
                    <value name="VALUE">
                      <block type="math_number" id="mg_num"><field name="NUM">2</field></block>
                    </value>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </statement>

    <!-- Trade Options (Dual Barriers for Straddle) -->
    <statement name="SUBMARKET">
      <block type="trade_definition_tradeoptions" id="trade_opts_block">
        <mutation has_first_barrier="true" has_second_barrier="true" has_prediction="false"></mutation>
        <field name="DURATIONTYPE_LIST">t</field>
        <field name="CURRENCY_LIST">USD</field>
        <value name="DURATION">
          <block type="math_number" id="duration_num"><field name="NUM">5</field></block>
        </value>
        <value name="AMOUNT">
          <block type="variables_get" id="get_stake_opt"><field name="VAR" id="stake_var">Stake</field></block>
        </value>
      </block>
    </statement>
  </block>

  <!-- 2. MARKET ANALYSIS AND ENTRY LOGIC -->
  <block type="before_purchase" id="before_p_block" x="0" y="600">
    <statement name="BEFOREPURCHASE_STACK">
      
      <!-- Calculate RSI (14) -->
      <block type="variables_set" id="calc_rsi">
        <field name="VAR" id="rsi_val">RSI Value</field>
        <value name="VALUE">
          <block type="rsi" id="rsi_block">
            <value name="INPUT">
              <block type="ohlc_values" id="ohlc_close">
                <field name="OHLCFIELD_LIST">close</field>
                <field name="CANDLEINTERVAL_LIST">default</field>
              </block>
            </value>
            <value name="PERIOD">
              <block type="math_number" id="rsi_period"><field name="NUM">14</field></block>
            </value>
          </block>
        </value>
        <next>
          
          <!-- Calculate MACD -->
          <block type="variables_set" id="calc_macd">
            <field name="VAR" id="macd_val">MACD Value</field>
            <value name="VALUE">
              <block type="macda" id="macd_block">
                <field name="MACDFIELDS_LIST">0</field> <!-- MACD Line -->
                <value name="INPUT">
                  <block type="ohlc_values" id="ohlc_close_macd">
                    <field name="OHLCFIELD_LIST">close</field>
                    <field name="CANDLEINTERVAL_LIST">default</field>
                  </block>
                </value>
                <value name="FAST_EMA_PERIOD"><shadow type="math_number" id="fast"><field name="NUM">12</field></shadow></value>
                <value name="SLOW_EMA_PERIOD"><shadow type="math_number" id="slow"><field name="NUM">26</field></shadow></value>
                <value name="SMA_PERIOD"><shadow type="math_number" id="sma"><field name="NUM">9</field></shadow></value>
              </block>
            </value>
            <next>
              
              <!-- Combined Logic: RSI + MACD -->
              <block type="controls_if" id="logic_check">
                <mutation elseif="1" else="1"></mutation>
                
                <!-- BUY HIGHER Condition: RSI < 30 (Oversold) AND MACD > 0 (Bullish) -->
                <value name="IF0">
                  <block type="logic_operation" id="and_high">
                    <field name="OP">AND</field>
                    <value name="A">
                      <block type="logic_compare" id="rsi_low">
                        <field name="OP">LT</field>
                        <value name="A"><block type="variables_get" id="get_rsi_high"><field name="VAR" id="rsi_val">RSI Value</field></block></value>
                        <value name="B"><block type="math_number" id="num_30"><field name="NUM">30</field></block></value>
                      </block>
                    </value>
                    <value name="B">
                      <block type="logic_compare" id="macd_pos">
                        <field name="OP">GT</field>
                        <value name="A"><block type="variables_get" id="get_macd_high"><field name="VAR" id="macd_val">MACD Value</field></block></value>
                        <value name="B"><block type="math_number" id="num_0"><field name="NUM">0</field></block></value>
                      </block>
                    </value>
                  </block>
                </value>
                <statement name="DO0">
                  <block type="notify" id="notify_buy">
                    <field name="NOTIFICATION_TYPE">success</field>
                    <field name="NOTIFICATION_SOUND">silent</field>
                    <value name="MESSAGE"><shadow type="text" id="txt_buy"><field name="TEXT">Strong Bullish Signal! Buying HIGHER...</field></shadow></value>
                    <next>
                      <block type="purchase" id="purchase_higher">
                        <field name="PURCHASE_LIST">HIGHER</field>
                      </block>
                    </next>
                  </block>
                </statement>

                <!-- BUY LOWER Condition: RSI > 70 (Overbought) AND MACD < 0 (Bearish) -->
                <value name="IF1">
                  <block type="logic_operation" id="and_low">
                    <field name="OP">AND</field>
                    <value name="A">
                      <block type="logic_compare" id="rsi_high">
                        <field name="OP">GT</field>
                        <value name="A"><block type="variables_get" id="get_rsi_low"><field name="VAR" id="rsi_val">RSI Value</field></block></value>
                        <value name="B"><block type="math_number" id="num_70"><field name="NUM">70</field></block></value>
                      </block>
                    </value>
                    <value name="B">
                      <block type="logic_compare" id="macd_neg">
                        <field name="OP">LT</field>
                        <value name="A"><block type="variables_get" id="get_macd_low"><field name="VAR" id="macd_val">MACD Value</field></block></value>
                        <value name="B"><block type="math_number" id="num_0_neg"><field name="NUM">0</field></block></value>
                      </block>
                    </value>
                  </block>
                </value>
                <statement name="DO1">
                  <block type="notify" id="notify_sell">
                    <field name="NOTIFICATION_TYPE">warn</field>
                    <field name="NOTIFICATION_SOUND">silent</field>
                    <value name="MESSAGE"><shadow type="text" id="txt_sell"><field name="TEXT">Strong Bearish Signal! Buying LOWER...</field></shadow></value>
                    <next>
                      <block type="purchase" id="purchase_lower">
                        <field name="PURCHASE_LIST">LOWER</field>
                      </block>
                    </next>
                  </block>
                </statement>
                
                <!-- Neutral Market: Do Not Trade -->
                <statement name="ELSE">
                  <block type="notify" id="notify_neutral">
                    <field name="NOTIFICATION_TYPE">info</field>
                    <field name="NOTIFICATION_SOUND">silent</field>
                    <value name="MESSAGE"><shadow type="text" id="txt_neutral"><field name="TEXT">Market is neutral. Scanning for entry...</field></shadow></value>
                  </block>
                </statement>
              </block>
            </next>
          </block>
        </next>
      </block>
    </statement>
  </block>

  <!-- 3. AFTER PURCHASE: MONEY MANAGEMENT & LOOP -->
  <block type="after_purchase" id="after_p_block" x="0" y="1200">
    <statement name="AFTERPURCHASE_STACK">
      <block type="controls_if" id="win_loss_check">
        <mutation else="1"></mutation>
        
        <!-- WIN LOGIC -->
        <value name="IF0">
          <block type="contract_check_result" id="check_win"><field name="CHECK_RESULT">win</field></block>
        </value>
        <statement name="DO0">
          <block type="variables_set" id="reset_stake">
            <field name="VAR" id="stake_var">Stake</field>
            <value name="VALUE"><block type="math_number" id="reset_val"><field name="NUM">1</field></block></value>
            <next>
              <block type="text_print" id="print_win">
                <value name="TEXT"><shadow type="text" id="t_win"><field name="TEXT">Trade Won! Stake reset to 1.</field></shadow></value>
              </block>
            </next>
          </block>
        </statement>
        
        <!-- LOSS LOGIC (MARTINGALE) -->
        <statement name="ELSE">
          <block type="variables_set" id="increase_stake">
            <field name="VAR" id="stake_var">Stake</field>
            <value name="VALUE">
              <block type="math_arithmetic" id="martingale_calc">
                <field name="OP">MULTIPLY</field>
                <value name="A"><block type="variables_get" id="get_stake_loss"><field name="VAR" id="stake_var">Stake</field></block></value>
                <value name="B"><block type="variables_get" id="get_mg_val"><field name="VAR" id="martingale_var">Martingale Factor</field></block></value>
              </block>
            </value>
            <next>
              <block type="text_print" id="print_loss">
                <value name="TEXT"><shadow type="text" id="t_loss"><field name="TEXT">Trade Lost. Increasing stake...</field></shadow></value>
              </block>
            </next>
          </block>
        </statement>
        
        <!-- CHECK LIMITS AND LOOP -->
        <next>
          <block type="controls_if" id="limits_check">
            <mutation elseif="1" else="1"></mutation>
            
            <!-- Take Profit Check -->
            <value name="IF0">
              <block type="logic_compare" id="tp_check">
                <field name="OP">GTE</field>
                <value name="A"><block type="total_profit" id="tp_val"></block></value>
                <value name="B"><block type="variables_get" id="get_tp_val"><field name="VAR" id="take_profit_var">Take Profit</field></block></value>
              </block>
            </value>
            <statement name="DO0">
              <block type="text_print" id="print_tp">
                <value name="TEXT"><shadow type="text" id="t_tp"><field name="TEXT">Target Profit Reached! Bot Stopped.</field></shadow></value>
              </block>
            </statement>

            <!-- Stop Loss Check -->
            <value name="IF1">
              <block type="logic_compare" id="sl_check">
                <field name="OP">LTE</field>
                <value name="A"><block type="total_profit" id="sl_val"></block></value>
                <value name="B">
                  <block type="math_single" id="neg_sl">
                    <field name="OP">NEG</field>
                    <value name="NUM"><block type="variables_get" id="get_sl_val"><field name="VAR" id="stop_loss_var">Stop Loss</field></block></value>
                  </block>
                </value>
              </block>
            </value>
            <statement name="DO1">
              <block type="text_print" id="print_sl">
                <value name="TEXT"><shadow type="text" id="t_sl"><field name="TEXT">Stop Loss Hit! Bot Stopped.</field></shadow></value>
              </block>
            </statement>

            <!-- Loop if limits not hit -->
            <statement name="ELSE">
              <block type="trade_again" id="trade_again_block"></block>
            </statement>
          </block>
        </next>
      </block>
    </statement>
  </block>
</xml>
